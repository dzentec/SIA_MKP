# RunPod Orchestrator Configuration Template (Example)
# Скопируйте этот файл в .env в этой же папке и укажите свои реальные данные

# 1. Секреты RunPod
RUNPOD_API_KEY=rpa_YOUR_RUNPOD_API_KEY_HERE
SSH_KEY_PATH=~/.ssh/id_ed25519

# 2. Выбор GPU и Pod
GPU_TYPE=NVIDIA GeForce RTX 4090
GPU_COUNT=1
POD_DISK_SIZE_GB=40
# Оставьте пустым для авто-создания нового пода или укажите существующий ID
POD_ID=

# 3. Папки ввода / вывода
SOURCE_BOOKS_DIR=.init_doc/source_doc
OUTPUT_BOOKPACKS_DIR=qa/bookpacks

# 4. Модель и поведение
VLM_MODEL=qwen2.5vl:32b
TEXT_MODEL=qwen2.5vl:32b
AUTO_STOP=true
